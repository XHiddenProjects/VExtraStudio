{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vextra Studio",
  "version": "4.3.1",
  "identifier": "studio.vextra.app",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vextra Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Web development and 2D/3D game creation",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/server/*"
    ],
    "windows": {
      "wix": {
        "fragmentPaths": [
          "./windows/fragments/data-removal.wxs"
        ],
        "componentRefs": [
          "VextraDataRemoval"
        ]
      },
      "nsis": {
        "installerHooks": "./windows/nsis-hooks.nsh"
      },
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "copyright": "© 2026 XHiddenProjects",
    "homepage": "https://github.com/XHiddenProjects/VExtraStudio",
    "longDescription": "Vextra Studio is a desktop workspace for web development and 2D/3D game making: code editor, UI designer, block-based game editor, Blender link, store export and a local server.",
    "fileAssociations": [
      {
        "ext": [
          "vxpack"
        ],
        "name": "Vextra Project Pack",
        "description": "Vextra Studio project pack (code, assets, levels)",
        "role": "Editor",
        "mimeType": "application/x-vextra-pack"
      },
      {
        "ext": [
          "vxgame"
        ],
        "name": "Vextra Game",
        "description": "Vextra Studio game project",
        "role": "Editor",
        "mimeType": "application/x-vextra-game"
      },
      {
        "ext": [
          "vxs"
        ],
        "name": "VXScript",
        "description": "VXScript (compiles to Vextra blocks)",
        "role": "Editor",
        "mimeType": "text/x-vxscript"
      }
    ],
    "linux": {
      "deb": {
        "preInstallScript": "./linux/stop-server.sh",
        "preRemoveScript": "./linux/stop-server.sh"
      },
      "rpm": {
        "preInstallScript": "./linux/stop-server.sh",
        "preRemoveScript": "./linux/stop-server.sh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/XHiddenProjects/VExtraStudio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
