{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vextra Studio",
  "version": "2.0.0",
  "identifier": "studio.vextra.app",
  "build": { "frontendDist": "../renderer" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vextra Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Web development and 2D/3D game creation",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
